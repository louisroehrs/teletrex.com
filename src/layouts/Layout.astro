---
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'TeleTrex \u2014 AI that helps your business grow without the busywork',
	description = 'Fast, friendly AI solutions for startups and small businesses. Scale operations, shorten the path from interest to customer, and spend less time on repetitive questions.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico?v2" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
		<CookieConsent />
	</body>
</html>

<style is:global>
	:root {
		--color-bg: #faf8f5;
		--color-surface: #ffffff;
		--color-text: #1c1917;
		--color-text-muted: #57534e;
		--color-accent: #0f766e;
		--color-accent-hover: #0d9488;
		--color-border: #e7e5e4;
		--font-display: 'Fraunces', Georgia, 'Times New Roman', serif;
		--font-body: 'Plus Jakarta Sans', system-ui, sans-serif;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-height: 100%;
		font-family: var(--font-body);
		font-size: 1.0625rem;
		line-height: 1.6;
		color: var(--color-text);
		background: var(--color-bg);
		-webkit-font-smoothing: antialiased;
		position: relative;
	}

	body::before {
		content: '';
		position: fixed;
		inset: 0;
		background-image: url('/teletrex%20large%20inverted%20transparent.png');
		background-repeat: no-repeat;
		background-position: center center;
		background-size: min(640px, 120vmin);
		opacity: 0.8;
		pointer-events: none;
		z-index: -10;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.65rem 1.15rem;
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 0.9375rem;
		text-decoration: none;
		border-radius: 0.5rem;
		transition:
			background 0.15s ease,
			color 0.15s ease,
			box-shadow 0.15s ease;
	}

	.btn--header {
		color: var(--color-accent);
		background: transparent;
		box-shadow: inset 0 0 0 2px var(--color-accent);
	}

	.btn--header:hover {
		color: #fff;
		background: var(--color-accent);
	}

	.btn--primary {
		color: #fff;
		background: var(--color-accent);
		box-shadow: 0 1px 2px rgba(28, 25, 23, 0.08);
	}

	.btn--primary:hover {
		background: var(--color-accent-hover);
	}

	.btn--large {
		padding: 0.85rem 1.5rem;
		font-size: 1rem;
	}
</style>
