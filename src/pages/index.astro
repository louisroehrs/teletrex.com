---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { BOOK_CALL_URL } from '../config/site';
---

<Layout>
	<div class="page">
		<SiteHeader />

		<main>
			<section class="hero">
				<p class="eyebrow">For startups &amp; growing businesses</p>
				<h1>Scale operations without scaling overhead.</h1>
        <p class="subhead">
        AI solutions for freeing businesses from support costs to accelerated revenue growth.
        </p>
				<p class="lead">
					We provide fast, friendly, AI-based solutions designed to shorten the path from interest to customer and cuts repetitive hand-holding pre and post conversion online. 
				</p>
				<p class="lead">
					We focus on the best experience for eliminating the business pain, then build a solution that helps your prospects and customers while you work on the next big thing.
				</p>
				<div class="card hero__actions">
					<a class="btn btn--primary" href={BOOK_CALL_URL}>Book a call</a>
					<p class="hero__note">Let's have a first talk. We’ll work with you to find the best area to attack and show what could be.</p>
				</div>
			</section>

			<section class="section" aria-labelledby="pains-heading">
				<h2 id="pains-heading">Sound familiar?</h2>
				<ul class="cards">
					<li class="card">
						<h3>Leads go cold while you’re in meetings</h3>
						<p>
							Prospects ask the same questions over the phone, email and DMs. By the time someone replies, they’ve moved on.
						</p>
					</li>
					<li class="card">
						<h3>Your best people are stuck repeating themselves</h3>
						<p>
							Pricing, onboarding, “how does this work?”—it adds up. That’s time not spent selling,
							serving, or shipping.
						</p>
					</li>
					<li class="card">
						<h3>Growth feels expensive</h3>
						<p>
							Hiring for every extra conversation doesn’t scale. You need leverage without a huge new
							headcount line.
						</p>
					</li>
				</ul>
			</section>

			<section class="section section--tint" aria-labelledby="help-heading">
				<h2 id="help-heading">What we do</h2>
				<p class="section__intro">
                Augment your online support with an intelligent search on your site that not only handles customer questions, but also carries out tasks that used to require support people to complete.  Free your support team to handle the more complex issues while your new search bar exceeds customer expectations. Customers don't need to navigate your site when the TeleTrex Associate in your search bar can handle most any request.
						</p>
				<p class="section__intro">
                View analytics to see what your customers and prospects are asking and wanting to do.  See how each inquiry was handled and which were escalated to support to proactively learn and handle more inquiry types over time.
						</p>
					</li>
				</ul>
			</section>

			<section class="section section--tint" aria-labelledby="help-heading">
				<h2 id="help-heading">What we build</h2>
				<p class="section__intro">


					Practical AI assistants and workflows trained on how <em>you</em> talk to customers and run the
					business. The goal is simple: faster answers, fewer dropped balls, and a lighter load on your
					team.
				</p>
				<ul class="bullets">
					<li>
						<strong>Clear next steps for leads and customers</strong> — so fewer conversations stall or
						bounce.
					</li>
					<li>
						<strong>Consistent, on-brand answers</strong> — 24/7 where it helps, with guardrails so conversations are always redirected politely back to your business. 
					</li>
					<li>
						<strong>Connected to how you already work</strong> — email, forms, your site, or the tools you
						already use (we’ll keep it straightforward).
					</li>
					<li>
						<strong>Secure</strong> — your data stays onsite. Our 26 years of experience securing Fortune 500 data is leveraged to provide the utmost in data security.
					</li>
				</ul>
			</section>

			<section class="cta-band" aria-labelledby="cta-heading">
				<h2 id="cta-heading">Call us and let's discover an improved, scalable reality.</h2>
				<p>If we’re not the right fit, we’ll say so.</p>
				<a class="btn btn--primary btn--large" href={BOOK_CALL_URL}>Book a call</a>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>

<style>
	.page {
		max-width: 58rem;
		margin: 0 auto;
		padding: 1.25rem 1.5rem 3rem;
	}

	.hero {
		padding-bottom: 3rem;
	}

	.eyebrow {
		margin: 0 0 0.75rem;
    font-family: 'Plus Jakarta Sans';
		font-size: 0.98125rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-accent);

	}

	.hero h1 {
		margin: 0 0 1rem;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(2rem, 5vw, 2.75rem);
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	.subhead {
		margin: 0 0 0.75rem;
		font-size: 1.2rem;
		line-height: 1.5;
		color: var(--color-text);
		font-weight: 500;
		max-width: 36rem;
	}

	.lead {
		margin: 0 0 1.75rem;
		font-size: 1.0625rem;
		line-height: 1.65;
		color: var(--color-text-muted);
		max-width: 40rem;
	}

	.hero__actions {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 2rem;
	}

	.hero__note {
		margin: 0;
		font-size: 0.875rem;
		color: var(--color-text-muted);
		max-width: 21em;
	}

	.section {
		padding: 2.5rem 0;
		border-top: 1px solid var(--color-border);
	}

	.section h2 {
		margin: 0 0 1.25rem;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.5rem;
		letter-spacing: -0.02em;
	}

	.cards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	@media (min-width: 640px) {
		.cards {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.25rem;
		}
	}

	.card {
		margin: 0;
		padding: 1.25rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		box-shadow: 0 1px 2px rgba(28, 25, 23, 0.04);
	}

	.card h3 {
		margin: 0 0 0.5rem;
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.35;
	}

	.card p {
		margin: 0;
		font-size: 0.9375rem;
		color: var(--color-text-muted);
		line-height: 1.55;
	}

	.section--tint {
		background: var(--color-surface);
		padding: 2.5rem 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
    margin-bottom: 2.5rem;
	}

	.section__intro {
		margin: 0 0 1.25rem;
		color: var(--color-text-muted);

	}

	.section__intro em {
		font-style: italic;
		color: var(--color-text);
	}

	.bullets {
		margin: 0;
		padding-left: 1.15rem;
		color: var(--color-text-muted);
	}

	.bullets li {
		margin-bottom: 0.75rem;
		padding-left: 0.35rem;
	}

	.bullets li:last-child {
		margin-bottom: 0;
	}

	.bullets strong {
		color: var(--color-text);
		font-weight: 600;
	}

	.cta-band {
		margin-top: 2.5rem;
		padding: 2.5rem 1.5rem;
		text-align: center;
		background: linear-gradient(160deg, #f0fdfa 0%, #faf8f5 100%);
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
	}

	.cta-band h2 {
		margin: 0 0 0.5rem;
		font-family: var(--font-cta);
		font-weight: 600;
		font-size: 1.35rem;
		letter-spacing: -0.02em;
	}

	.cta-band p {
		margin: 0 0 1.25rem;
		color: var(--color-text-muted);
		font-size: 0.9375rem;
	}

</style>
