---
import InnerPage from '../layouts/InnerPage.astro';
---

<InnerPage
	title="Ekanta Stats"
	description="Download statistics for Ekanta by TeleTrex — live from GitHub releases."
>
	<div class="stats-header">
		<div>
			<h1>Ekanta Download Stats</h1>
			<p class="page-lead">Live download data pulled directly from GitHub.</p>
		</div>
		<a class="stats-gh-link" href="https://github.com/louisroehrs/teletrex-ekanta/releases" target="_blank" rel="noopener">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
			</svg>
			View on GitHub
		</a>
	</div>

	<!-- Stat cards -->
	<div class="stat-grid" id="stat-grid">
		<div class="stat-card stat-card--highlight">
			<p class="stat-card__label">Total Downloads</p>
			<p class="stat-card__value" id="stat-total"><span class="skeleton"></span></p>
			<p class="stat-card__sub">across all releases</p>
		</div>
		<div class="stat-card">
			<p class="stat-card__label">Apple Silicon</p>
			<p class="stat-card__value" id="stat-arm64"><span class="skeleton"></span></p>
			<p class="stat-card__sub">arm64 builds</p>
		</div>
		<div class="stat-card">
			<p class="stat-card__label">Intel Mac</p>
			<p class="stat-card__value" id="stat-x64"><span class="skeleton"></span></p>
			<p class="stat-card__sub">x64 builds</p>
		</div>
		<div class="stat-card">
			<p class="stat-card__label">Latest Release</p>
			<p class="stat-card__value stat-card__value--tag" id="stat-version"><span class="skeleton"></span></p>
			<p class="stat-card__sub" id="stat-date">&nbsp;</p>
		</div>
	</div>

	<!-- Releases -->
	<h2 class="section-title">Releases</h2>
	<div id="releases-container">
		<div class="release-card release-card--skeleton">
			<div class="release-card__header">
				<div class="release-card__meta">
					<span class="skeleton skeleton--tag"></span>
					<span class="skeleton skeleton--name"></span>
				</div>
				<span class="skeleton skeleton--date"></span>
			</div>
			<div class="asset-list">
				<div class="asset-row">
					<span class="skeleton skeleton--asset"></span>
					<span class="skeleton skeleton--count"></span>
				</div>
				<div class="asset-row">
					<span class="skeleton skeleton--asset"></span>
					<span class="skeleton skeleton--count"></span>
				</div>
			</div>
		</div>
	</div>

	<p class="fetched-at" id="fetched-at"></p>

	<div class="error-msg" id="error-msg" hidden>
		Could not fetch release data from GitHub. The API may be rate-limited or unavailable.
	</div>
</InnerPage>

<script>
	function formatBytes(bytes: number): string {
		return (bytes / 1024 / 1024).toFixed(0) + ' MB';
	}

	function formatDate(iso: string): string {
		return new Date(iso).toLocaleDateString('en-US', {
			year: 'numeric', month: 'long', day: 'numeric'
		});
	}

	function assetLabel(name: string): string {
		return name.includes('arm64') ? 'Apple Silicon' : 'Intel Mac';
	}

	function downloadIcon(): string {
		return `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
			<polyline points="7 10 12 15 17 10"/>
			<line x1="12" y1="15" x2="12" y2="3"/>
		</svg>`;
	}

	interface Asset {
		name: string;
		size: number;
		download_count: number;
		browser_download_url: string;
	}

	interface Release {
		name: string;
		tag_name: string;
		published_at: string;
		html_url: string;
		prerelease: boolean;
		draft: boolean;
		assets: Asset[];
	}

	async function loadStats() {
		try {
			const res = await fetch('https://api.github.com/repos/louisroehrs/teletrex-ekanta/releases', {
				headers: { 'Accept': 'application/vnd.github+json' }
			});

			if (!res.ok) throw new Error(`GitHub API returned ${res.status}`);

			const releases: Release[] = await res.json();
			const allAssets = releases.flatMap(r => r.assets);
			const totalDownloads = allAssets.reduce((sum, a) => sum + a.download_count, 0);
			const arm64Total = allAssets.filter(a => a.name.includes('arm64')).reduce((sum, a) => sum + a.download_count, 0);
			const x64Total = allAssets.filter(a => !a.name.includes('arm64')).reduce((sum, a) => sum + a.download_count, 0);
			const latest = releases.find(r => !r.prerelease && !r.draft);

			// Update stat cards
			document.getElementById('stat-total')!.textContent = totalDownloads.toLocaleString();
			document.getElementById('stat-arm64')!.textContent = arm64Total.toLocaleString();
			document.getElementById('stat-x64')!.textContent = x64Total.toLocaleString();
			document.getElementById('stat-version')!.textContent = latest?.tag_name ?? '—';
			document.getElementById('stat-date')!.textContent = latest ? formatDate(latest.published_at) : '';

			// Render release cards
			const container = document.getElementById('releases-container')!;
			container.innerHTML = releases
				.filter(r => !r.draft)
				.map(release => {
					const releaseTotal = release.assets.reduce((s, a) => s + a.download_count, 0);
					return `
						<div class="release-card">
							<div class="release-card__header">
								<div class="release-card__meta">
									<span class="release-tag">${release.tag_name}</span>
									${release.prerelease ? '<span class="release-badge release-badge--pre">Pre-release</span>' : ''}
									<h3 class="release-card__name">${release.name}</h3>
								</div>
								<div class="release-card__date">Published ${formatDate(release.published_at)}</div>
							</div>
							<div class="asset-list">
								${release.assets.map(asset => `
									<div class="asset-row">
										<div class="asset-row__info">
											<span class="asset-platform">${assetLabel(asset.name)}</span>
											<span class="asset-filename">${asset.name}</span>
										</div>
										<div class="asset-row__stats">
											<span class="asset-size">${formatBytes(asset.size)}</span>
											<span class="asset-downloads">${downloadIcon()} ${asset.download_count.toLocaleString()}</span>
											<a class="asset-link" href="${asset.browser_download_url}" download>Download</a>
										</div>
									</div>
								`).join('')}
							</div>
							<div class="release-card__footer">
								<span class="release-total">${releaseTotal.toLocaleString()} total downloads for this release</span>
								<a class="release-gh-link" href="${release.html_url}" target="_blank" rel="noopener">Release notes →</a>
							</div>
						</div>
					`;
				}).join('');

			const now = new Date().toLocaleString('en-US', {
				year: 'numeric', month: 'long', day: 'numeric',
				hour: '2-digit', minute: '2-digit', timeZoneName: 'short'
			});
			document.getElementById('fetched-at')!.textContent = `Fetched ${now}`;

		} catch (err) {
			console.error('Stats fetch failed:', err);
			document.getElementById('releases-container')!.innerHTML = '';
			document.getElementById('error-msg')!.hidden = false;
			['stat-total','stat-arm64','stat-x64','stat-version'].forEach(id => {
				document.getElementById(id)!.textContent = '—';
			});
		}
	}

	loadStats();
</script>

<style is:global>
	/* ── Page header ─────────────────────────────────────────────────────── */
	.stats-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 0.25rem;
	}

	.stats-gh-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.5rem 1rem;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--color-text-muted);
		border: 1px solid var(--color-border);
		border-radius: 0.5rem;
		text-decoration: none;
		white-space: nowrap;
		margin-top: 0.5rem;
		transition: border-color 0.15s ease, color 0.15s ease;
	}

	.stats-gh-link:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	/* ── Skeletons ───────────────────────────────────────────────────────── */
	@keyframes shimmer {
		0%   { background-position: -400px 0; }
		100% { background-position: 400px 0; }
	}

	.skeleton {
		display: inline-block;
		border-radius: 0.3rem;
		background: linear-gradient(90deg, var(--color-border) 25%, color-mix(in srgb, var(--color-border) 60%, white) 50%, var(--color-border) 75%);
		background-size: 800px 100%;
		animation: shimmer 1.4s infinite linear;
		height: 1em;
		width: 3rem;
	}

	.skeleton--tag  { width: 3.5rem; height: 1.4rem; }
	.skeleton--name { width: 12rem; height: 1.1rem; }
	.skeleton--date { width: 8rem;  height: 0.9rem; }
	.skeleton--asset { width: 16rem; height: 0.9rem; }
	.skeleton--count { width: 3rem;  height: 0.9rem; }

	/* ── Error ───────────────────────────────────────────────────────────── */
	.error-msg {
		padding: 1.25rem 1.5rem;
		background: #fff8f8;
		border: 1px solid #fecaca;
		border-radius: 0.75rem;
		color: #991b1b;
		font-size: 0.9375rem;
		margin-bottom: 2rem;
	}

	/* ── Stat cards ──────────────────────────────────────────────────────── */
	.stat-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
		margin: 0 0 2.75rem;
	}

	@media (max-width: 700px) { .stat-grid { grid-template-columns: repeat(2, 1fr); } }
	@media (max-width: 400px) { .stat-grid { grid-template-columns: 1fr; } }

	.stat-card {
		padding: 1.25rem 1.5rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 0.875rem;
	}

	.stat-card--highlight {
		background: var(--color-dark);
		border-color: rgba(59, 130, 246, 0.25);
		position: relative;
		overflow: hidden;
	}

	.stat-card--highlight::before {
		content: '';
		position: absolute;
		top: 0; left: 0; right: 0;
		height: 2px;
		background: linear-gradient(90deg, transparent, #3b82f6 40%, #22d3ee 70%, transparent);
	}

	.stat-card__label {
		margin: 0 0 0.5rem;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: var(--color-text-muted);
	}

	.stat-card--highlight .stat-card__label { color: #60a5fa; }

	.stat-card__value {
		margin: 0 0 0.3rem;
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1;
		color: var(--color-accent);
		min-height: 1em;
	}

	.stat-card--highlight .stat-card__value {
		background: linear-gradient(135deg, #ffffff 0%, #93c5fd 50%, #22d3ee 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.stat-card__value--tag { font-size: clamp(1.5rem, 3vw, 2rem); }

	.stat-card__sub {
		margin: 0;
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	.stat-card--highlight .stat-card__sub { color: #475569; }

	/* ── Release cards ───────────────────────────────────────────────────── */
	.release-card {
		margin-bottom: 1.25rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 0.875rem;
		overflow: hidden;
	}

	.release-card__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 1.25rem 1.5rem;
		border-bottom: 1px solid var(--color-border);
	}

	.release-card--skeleton .release-card__header { align-items: center; }

	.release-card__meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	.release-tag {
		font-family: 'SF Mono', 'Fira Code', monospace;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 10%, transparent);
		padding: 0.2em 0.55em;
		border-radius: 0.3rem;
		border: 1px solid color-mix(in srgb, var(--color-accent) 20%, transparent);
	}

	.release-badge {
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 0.15em 0.5em;
		border-radius: 0.25rem;
	}

	.release-badge--pre {
		color: #92400e;
		background: #fef3c7;
		border: 1px solid #fde68a;
	}

	.release-card__name {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--color-text);
		letter-spacing: -0.01em;
	}

	.release-card__date {
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}

	/* ── Asset rows ──────────────────────────────────────────────────────── */
	.asset-list { padding: 0.5rem 0; }

	.asset-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
		border-bottom: 1px solid var(--color-border);
	}

	.asset-row:last-child { border-bottom: none; }

	.asset-row__info {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
	}

	.asset-platform {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--color-text);
		white-space: nowrap;
	}

	.asset-filename {
		font-family: 'SF Mono', 'Fira Code', monospace;
		font-size: 0.8rem;
		color: var(--color-text-muted);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.asset-row__stats {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		flex-shrink: 0;
	}

	.asset-size {
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}

	.asset-downloads {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.9375rem;
		font-weight: 700;
		font-family: var(--font-display);
		color: var(--color-accent);
	}

	.asset-link {
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--color-accent);
		text-decoration: none;
		padding: 0.3rem 0.75rem;
		border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
		border-radius: 0.375rem;
		transition: background 0.15s ease, color 0.15s ease;
	}

	.asset-link:hover {
		background: var(--color-accent);
		color: #fff;
	}

	/* ── Release footer ──────────────────────────────────────────────────── */
	.release-card__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0.875rem 1.5rem;
		background: var(--color-bg);
		border-top: 1px solid var(--color-border);
	}

	.release-total {
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}

	.release-gh-link {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--color-accent);
		text-decoration: none;
	}

	.release-gh-link:hover { text-decoration: underline; }

	/* ── Fetch timestamp ─────────────────────────────────────────────────── */
	.fetched-at {
		margin-top: 2.5rem;
		font-size: 0.8125rem;
		color: var(--color-text-muted);
		opacity: 0.7;
	}
</style>
