---
import { SITE_NAME } from '../config/site';
---

<footer class="site-footer">
	<p class="site-footer__brand">{SITE_NAME}</p>
	<p class="site-footer__meta">
		AI solutions for freeing businesses from support costs to accelerated revenue growth.
  </p>
  <br/>
 	<p class="site-footer__meta">
    Designed and Built in Mountain View, California.
	</p>
  <br/>  <br/>  <br/>  <br/>
</footer>

<style>
	.site-footer {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-border);
		text-align: center;
	}

	.site-footer__brand {
		margin: 0 0 0.35rem;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.0625rem;
	}

	.site-footer__meta {
		margin: 0;
		font-size: 0.875rem;
		color: var(--color-text-muted);
		max-width: 28rem;
		margin-left: auto;
		margin-right: auto;
	}
</style>
