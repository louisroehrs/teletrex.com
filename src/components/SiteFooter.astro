---
import { SITE_NAME } from '../config/site';

const FOUNDED = 1980;
const currentYear = new Date().getFullYear();
const copyrightYear = currentYear > FOUNDED ? `${FOUNDED}–${currentYear}` : FOUNDED;
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<div class="site-footer__brand-col">
			<img src="/teletrex.png" width="120" alt={SITE_NAME} class="site-footer__logo" />
			<p class="site-footer__tagline">
				AI solutions that free businesses from support costs and accelerate revenue growth.
			</p>
		</div>
		<div class="site-footer__links">
			<a href="/products">Products</a>
			<a href="/pricing">Pricing</a>
			<a href="/case-studies">Case Studies</a>
      <a href="/products/ekanta">Ekanta</a>
			<a href="/about">About</a>
			<a href="/contact">Contact</a>
			<a href="https://linkedin.com/company/teletrex">LinkedIn ↗</a>
		</div>
	</div>
	<div class="site-footer__bottom">
		<p>© {copyrightYear} {SITE_NAME}. Headquartered, designed, and built in Mountain View, California.</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		padding: 3rem 1.5rem 2rem;
		max-width: 72rem;
		margin: 0 auto;
	}

	.site-footer__inner {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 2.5rem;
	}

	.site-footer__brand-col {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		max-width: 22rem;
	}

	.site-footer__logo {
		display: block;
		height: auto;
	}

	.site-footer__tagline {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.6;
		color: var(--color-text-muted);
	}

	.site-footer__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.5rem;
		align-items: flex-start;
	}

	.site-footer__links a {
		font-size: 0.9rem;
		color: var(--color-text-muted);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.site-footer__links a:hover {
		color: var(--color-accent);
	}

	.site-footer__bottom {
		border-top: 1px solid var(--color-border);
		padding-top: 1.5rem;
	}

	.site-footer__bottom p {
		margin: 0;
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}
</style>
